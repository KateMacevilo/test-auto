{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Ответ 200/201 — согласие listPassports (ListPassportsConsentResponse)",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "listPassportsConsentId",
        "link",
        "creationDateTime",
        "status",
        "statusUpdateDateTime",
        "initiation"
      ],
      "properties": {
        "listPassportsConsentId": {
          "type": "string",
          "minLength": 1
        },
        "link": {
          "type": "string"
        },
        "creationDateTime": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "AwaitingAuthorisation",
            "AwaitingFurtherAuthorisation",
            "Authorised",
            "Rejected",
            "Revoked",
            "Expired",
            "Accepted",
            "Consumed",
            "Invalidated"
          ]
        },
        "statusUpdateDateTime": {
          "type": "string"
        },
        "cutOffDateTime": {
          "type": [
            "string",
            "null"
          ]
        },
        "expectedExecutionDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "expectedSettlementDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "charge": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "authorisation": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "authorisationType": {
              "type": "string",
              "enum": [
                "Any",
                "Single",
                "Multiple"
              ]
            },
            "completionDateTime": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "initiation": {
          "type": "object",
          "required": [
            "instructionIdentification",
            "endToEndIdentification",
            "currency",
            "amount",
            "listPassportData",
            "remittanceInformation",
            "creditor",
            "creditorAccount"
          ],
          "properties": {
            "instructionIdentification": {
              "type": "string"
            },
            "endToEndIdentification": {
              "type": "string"
            },
            "localInstrument": {
              "type": [
                "string",
                "null"
              ]
            },
            "requestedExecutionDate": {
              "type": [
                "string",
                "null"
              ]
            },
            "currency": {
              "type": "string",
              "enum": [
                "BYN"
              ]
            },
            "amount": {
              "type": "number"
            },
            "listPassportData": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "identification",
                  "issuer",
                  "amount"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "identification": {
                    "type": "string"
                  },
                  "issuer": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number"
                  }
                }
              }
            },
            "remittanceInformation": {
              "type": "object",
              "required": [
                "categoryPurposeCode",
                "proprietaryPurpose",
                "unstructured"
              ],
              "properties": {
                "categoryPurposeCode": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]{4}$"
                },
                "proprietaryPurpose": {
                  "type": "string",
                  "pattern": "^[0-1][A-Z0-9]{5}\\.\\d{2}$"
                },
                "unstructured": {
                  "type": "string"
                },
                "referredDocument": {
                  "type": [
                    "array",
                    "null"
                  ]
                }
              }
            },
            "debtor": {
              "type": [
                "object",
                "null"
              ]
            },
            "debtorAccount": {
              "type": [
                "object",
                "null"
              ]
            },
            "debtorAgent": {
              "type": [
                "object",
                "null"
              ]
            },
            "creditor": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "countryOfResidence": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "organisationIdentification": {
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "privateIdentification": {
                  "type": [
                    "array",
                    "null"
                  ]
                },
                "postalAddress": {
                  "type": [
                    "object",
                    "null"
                  ]
                },
                "contactDetails": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            },
            "creditorAccount": {
              "type": "object",
              "required": [
                "schemeName",
                "identification"
              ],
              "properties": {
                "schemeName": {
                  "type": "string"
                },
                "identification": {
                  "type": "string"
                }
              }
            },
            "creditorAgent": {
              "type": [
                "object",
                "null"
              ]
            },
            "ultimateDebtor": {
              "type": [
                "object",
                "null"
              ]
            },
            "supplementaryData": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
